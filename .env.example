# Copy this file to .env and fill in your values. The .env file is NOT
# committed to version control. Anything you set here can also be set as a
# real environment variable, which takes precedence.

# ---- Email (SMTP) ----
# In development the default backend just prints emails to the console, so
# nothing is actually delivered. To send real email, uncomment EMAIL_BACKEND
# and configure your SMTP server (e.g. Gmail / Outlook / Mailtrap):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=30
# DEFAULT_FROM_EMAIL=Car Dealership <you@example.com>
# DEALERSHIP_NOTIFY_EMAIL=sales@example.com

# ---- Currency ----
# Every price on the site is stored and shown in Kenyan shillings. Change
# these two values if the dealership bills in another currency - the symbol
# is used everywhere a price is printed (pages, emails, the chatbot, the
# PDF and CSV exports).
# CURRENCY_SYMBOL=KSh
# CURRENCY_CODE=KES

# ---- Links in command-sent emails ----
# Base URL used to build clickable links in alert emails sent by management
# commands (there is no request to derive it from). Example:
# SITE_BASE_URL=https://www.my-dealership.com

# ---- Google Sign-In (OAuth 2.0) ----
# Create an OAuth 2.0 Client ID (type "Web application") in the Google Cloud
# Console and add the authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/callback/   (adjust to your domain)
# Leave both blank to hide the "Sign in with Google" button.
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# ---- Anti-spam captcha (optional) ----
# Public forms already have a hidden honeypot field and per-IP rate limiting,
# so a captcha is NOT required. To also show a captcha, set the site + secret
# key pair for ONE provider below (never commit real keys).
#
# hCaptcha (https://dashboard.hcaptcha.com):
# HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
# HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
#
# Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin):
# RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key
#
# Rate limiting is backed by Django's cache. The default (LocMemCache) is
# per-process, so set REDIS_URL (see the deployment section) when you deploy
# more than one worker. Re-enable/disable it with:
# ANTISPAM_RATE_LIMITS_ENABLED=true

# ---- Site chatbot ----
# The chat widget works out of the box using a built-in, offline FAQ/intent
# engine (no keys, no network). Set CHATBOT_ENABLED=false to hide it entirely.
#
# To upgrade answers to an LLM, set a provider and API key. If the provider is
# unreachable or unset, answers fall back to the built-in engine automatically.
#   CHATBOT_PROVIDER=openai | openai_compatible | gemini | anthropic
#   CHATBOT_API_KEY=your-key
#   CHATBOT_MODEL=gpt-4o-mini            # provider default used when blank
#   CHATBOT_BASE_URL=                     # only for openai_compatible (e.g. a local server)
#   CHATBOT_TIMEOUT=15
#
# Privacy: only the visitor's message and public site facts (dealership name,
# hours, address, and available inventory) are sent to the provider. No account
# or personal data is shared. Conversations are stored locally and visible only
# to staff in the "Chat Transcripts" panel.

# ---- Traffic analytics ----
# The staff panel records one page view per public page request so you can see
# where your visitors come from and what they look at (Staff -> Traffic).
# Staff browsing the staff panel, bots and redirects are not counted.
# Switch recording off with:
# TRAFFIC_TRACKING_ENABLED=false
#
# Raw visitor IP addresses are stored, so the table is deliberately kept
# small. Rows older than this are deleted automatically, at most once a day,
# so there is nothing to schedule. The `purge_traffic_data` command can also
# be run by hand at any time:
#   python manage.py purge_traffic_data --dry-run
#   python manage.py purge_traffic_data
# TRAFFIC_RETENTION_DAYS=90
#
# The same visitor hitting the same page again inside this many seconds is
# not recorded twice (refreshes, double clicks). 0 counts every request.
# The window uses Django's cache, so set REDIS_URL on a multi-worker deploy -
# with the default LocMemCache it is per-process and only under-counts repeats.
# TRAFFIC_DEDUPE_WINDOW=60
#
# 404s are not recorded by default: a request for a URL that does not exist
# is far more often a scanner than a visitor following a broken link.
# TRAFFIC_TRACK_404S=false
#
# Switch the automatic daily prune off to keep expired rows (the
# `purge_traffic_data` command still works).
# TRAFFIC_AUTO_PRUNE=true
#
# The report also carries a conversion funnel (visitors -> inquiries ->
# orders -> sales), broken down by source and by vehicle, and it can be
# downloaded as a CSV from the Traffic page. Nothing to configure here.

# ---- Google Analytics 4 ----
# Optional client-side analytics. Set a GA4 Measurement ID to load gtag.js and
# send page views plus conversion events (vehicle views, searches, inquiries,
# orders, test drives, financing, service, hire and listing requests).
# Leave it blank to make no third-party requests. Staff and admin pages are
# excluded so internal usage does not skew the reports.
# Tracking is opt-in: a cookie banner asks the visitor first, and gtag.js is
# not loaded until they accept. Set this to false only where consent is not
# required by law.
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GOOGLE_ANALYTICS_ENABLED=true
# GOOGLE_ANALYTICS_REQUIRE_CONSENT=true

# ---- Search console verification (optional) ----
# Paste the exact meta-tag contents from Google Search Console and Bing Webmaster
# Tools. Both are public values and are rendered as meta tags by base.html.
# GOOGLE_SITE_VERIFICATION=your-google-verification-token
# BING_SITE_VERIFICATION=your-bing-verification-token

# ---- Vehicle images ----
# Photos are resized, straightened and stripped of their EXIF data when they
# are uploaded, and a thumbnail is generated at the same time.
# CAR_IMAGE_MAX_WIDTH=1600
# CAR_IMAGE_THUMBNAIL_WIDTH=600
# CAR_IMAGE_QUALITY=85
# Uploads larger than this are rejected (in MB).
# MAX_UPLOAD_SIZE_MB=10
#
# Existing photos can be reprocessed with:
#   python manage.py reprocess_images --dry-run
#   python manage.py reprocess_images

# ---- Trade-in valuation ----
# The valuation rules are code constants in cars/tradein.py, not a table in
# the admin, so there is nothing to configure here. Change them in that file
# and deploy.

# ---- Listing fee ----
# What a customer pays to have their car advertised on the website (the
# "List Your Car" feature). The amount is copied onto each request when it
# is made, so changing it later never rewrites what a customer was quoted.
# The rules for what the fee buys - inspecting the car, verifying the
# logbook, and publishing the listing on the owner's behalf - are code
# constants in cars/listing.py, not a table in the admin.
# LISTING_FEE=2500


# Financing
# The annual interest rate shown on the financing page and used for the
# repayment estimate. The minimum deposit, the terms offered, and the
# affordability rule are code constants in cars/financing.py, not a table
# in the admin.
# FINANCING_INTEREST_RATE=14.5


# ---- M-Pesa (Safaricom Daraja) ----
# STK push payments for order deposits, listing fees and hire bookings.
# Leave MPESA_CONSUMER_KEY empty to switch online payments off; the site
# then falls back to "our team will contact you" and nothing breaks.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-site.example.com/payments/mpesa/callback/
# MPESA_ENVIRONMENT=sandbox
# MPESA_TIMEOUT=30
#
# How long the signed link in a payment email stays usable (seconds).
# MPESA_STATUS_TOKEN_MAX_AGE=2592000
#
# How old a pending payment must be before the fallback query asks
# Safaricom what happened to it (minutes).
# MPESA_QUERY_AFTER_MINUTES=10

# ---- Order deposit rule ----
# The deposit is a fraction of the amount payable after the trade-in,
# rounded up to the next step, with a floor and a ceiling of the amount
# payable. The same rule is documented in cars/deposits.py.
# ORDER_DEPOSIT_RATIO=0.10
# ORDER_DEPOSIT_MINIMUM=50000
# ORDER_DEPOSIT_ROUNDING=1000

# ---- Production / deployment (Render) ----
# See DEPLOYMENT.md for the full checklist. On Render these values belong in
# the dashboard (or render.yaml), never in a committed file. When DEBUG=false
# the protections below default to their safe values, but setting them
# explicitly documents intent and lets `python manage.py security_check`
# confirm them.
# DEBUG=false
# SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
# ALLOWED_HOSTS=www.example.com,example.com
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
# SITE_BASE_URL=https://www.example.com
# Admin path. Move it off the well-known /admin/ so scanners cannot find the
# login form. Keep the leading and trailing slash optional; it is normalized.
# ADMIN_URL=manage-<random-token>/
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false          # only after every subdomain is HTTPS
# USE_X_FORWARDED_PROTO=true         # TLS terminates at the platform proxy
# TRUST_X_FORWARDED_FOR=true         # platform overwrites X-Forwarded-For
# X_FORWARDED_FOR_PROXY_COUNT=1      # number of trusted proxies in front
#
# ---- Managed services (required on a PaaS) ----
# Postgres. Without it the app falls back to SQLite, which is not safe for
# more than one instance. Render injects this automatically.
# DATABASE_URL=postgres://user:password@host:5432/database
#
# Redis backs the cache (axes lockouts, rate limits, traffic de-dupe) and the
# Celery broker/result backend. Render injects this automatically.
# REDIS_URL=rediss://default:password@host:6379
# CELERY_BROKER_URL=            # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=        # defaults to REDIS_URL
# CELERY_TASK_TIME_LIMIT=900
# CELERY_TASK_SOFT_TIME_LIMIT=840
#
# ---- Object storage for uploads (S3 or Cloudflare R2) ----
# A PaaS filesystem is ephemeral: without this, car photos and documents are
# lost on every deploy. For R2 set AWS_S3_ENDPOINT_URL and
# AWS_S3_ADDRESSING_STYLE=virtual, and point AWS_S3_CUSTOM_DOMAIN at the
# bucket's public hostname.
# USE_S3=true
# USE_S3_FOR_STATIC=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.example.com
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_QUERYSTRING_AUTH=false
# AWS_S3_FILE_OVERWRITE=false
#
# ---- Logging and error reporting ----
# Render captures stdout. Set one of these so production 500s are not silent.
# DJANGO_ADMINS=Ops <ops@example.com>
# SERVER_EMAIL=alerts@example.com
# DJANGO_LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
#
# Content Security Policy. On by default; set a full policy string to replace
# the built-in one, or use report-only while tuning a new integration.
# CONTENT_SECURITY_POLICY_ENABLED=true
# CONTENT_SECURITY_POLICY=
# CONTENT_SECURITY_POLICY_REPORT_ONLY=false
#
# CORS is off unless a separate frontend is served from a known origin.
# CORS_ALLOWED_ORIGINS=https://app.example.com
#
# Staff two-factor authentication: a six-digit code is emailed at sign-in.
# Staff accounts without an email address skip the second factor, so give
# every staff member a real address.
# STAFF_2FA_ENABLED=true
# STAFF_2FA_TIMEOUT=300
# STAFF_2FA_MAX_ATTEMPTS=5
# STAFF_2FA_RESEND_SECONDS=60
#
# Backups: the daily Celery beat job writes here and prunes old copies. On a
# PaaS this directory is ephemeral - rely on managed Postgres backups/PITR
# and copy dumps off-box. When USE_S3 is on the dump is uploaded to the bucket
# automatically; set BACKUP_UPLOAD_TO_S3=false to keep it local only.
# BACKUP_DIR=/var/backups/dealership
# BACKUP_RETENTION_DAYS=30
# BACKUP_UPLOAD_TO_S3=true
# BACKUP_S3_PREFIX=backups
