# Copy this file to .env and fill in your values. The .env file is NOT
# committed to version control. Anything you set here can also be set as a
# real environment variable, which takes precedence.

# ---- Email (SMTP) ----
# In development the default backend just prints emails to the console, so
# nothing is actually delivered. To send real email, uncomment EMAIL_BACKEND
# and configure your SMTP server (e.g. Gmail / Outlook / Mailtrap):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=30
# DEFAULT_FROM_EMAIL=Car Dealership <you@example.com>
# DEALERSHIP_NOTIFY_EMAIL=sales@example.com